{
  "name": "MindAnchor Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mathiasfrohlich.Kotlin",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "echo 'Run ./gradlew test to verify the build.'"
}

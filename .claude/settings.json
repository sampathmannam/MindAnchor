{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(./gradlew.bat:*)",
      "Bash(.\\gradlew.bat:*)",
      "Bash(gradlew.bat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python tools/clinician-pack.py:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}

*.iml
.gradle/
build/
local.properties
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
!debug.keystore

# Signing keys never belong in the repository. The docs tell you to
# create mindanchor.jks, so make it impossible to commit by accident.
*.jks
*.jks.base64
*.base64

# Kotlin compiler session state, written on every build.
.kotlin/

# Local worktrees (not for commit)
.worktrees/

# Build log files (one-off logs from ./gradlew invocations)
build_*.log
gradle_*.log

saved_state/
_*.py
_*.py.tmp
_*.tmp
_debug_output.txt

# Source files moved aside via .kt.disabled (e.g. raw AIDL shims that
# became obsolete after an SDK upgrade). Kept on disk for the record
# so we can resurrect the approach if the upstream gate re-opens, but
# not part of the build and not in version control.
*.kt.disabled
*.java.disabled
*.aidl.disabled
app/src/main/java/org/mindanchor/vitals/.disabled/

<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) backup and transfer rules.

    Both channels are refused outright. cloud-backup covers Google Drive
    backup; device-transfer covers phone-to-phone migration. A safety plan
    and a crisis contact list are the most private things this app will
    ever hold, and neither belongs on someone else's hardware.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

    <string name="journal_onboarding_title">ஒரு சுருக்கச் சுற்றுலா.</string>
    <string name="journal_onboarding_subtitle">இந்த ஆவணப்பதிவைச் சுற்றி மூன்று விஷயங்கள். அமைப்புகளிலிருந்து இதை மீண்டும் திறக்கலாம்.</string>
    <string name="journal_onboarding_card1_title">மனநிலை — பெயரிடக்கூடிய ஒன்று.</string>
    <string name="journal_onboarding_card1_body">நொறுக்கப்பட்டது முதல் பிரகாசமானது வரை ஐந்து நிலைகள், அல்லது 2x2 கட்டம் (அமைப்புகள் → 2D மனநிலை). உணர்வைப் பெயரிடுவது அதை மாற்றுவதிலிருந்து வேறுபட்டது. ஒன்றைத் தேர்ந்தெடுங்கள், அல்லது எதுவும் இல்லை.</string>
    <string name="journal_onboarding_card2_title">திறன் — செய்யக்கூடிய ஒன்று.</string>
    <string name="journal_onboarding_card2_body">TIPP, STOP, DEAR MAN, Breathing Space, Wise Mind. இன்றைய திறன் வழங்கப்படுகிறது, கட்டளையிடப்படவில்லை. நீங்கள் அதைச் செய்தபோது முடிந்ததாகக் குறிக்கவும் — 60-விநாடி சாளரம் என்ன வந்தது என்பதைப் பதிவுசெய்ய அனுமதிக்கிறது.</string>
    <string name="journal_onboarding_card3_title">ஆவணப்பதிவு — கவனிக்கக்கூடிய ஒன்று.</string>
    <string name="journal_onboarding_card3_body">மூன்று ஸ்லைடர்கள்: NSSI, தற்கொலை, பிரிப்பு, ஒவ்வொன்றும் 0–5. நீங்கள் செய்தால் மட்டுமே எதுவும் பதிவு செய்யப்படும். உங்கள் சிகிச்சையாளருடன் PDF ஐப் பகிர்வதைத் தேர்ந்தெடுத்தால் மட்டுமே எதுவும் யாருக்கும் காட்டப்படும்.</string>
    <string name="journal_onboarding_got_it">புரிந்தது</string>
    <string name="journal_onboarding_dont_show">மீண்டும் காட்டாதே</string>

    <string name="settings_privacy_data">தனியுரிமை மற்றும் தரவு</string>
    <string name="settings_privacy_data_sublabel">MindAnchor என்ன சேமிக்கிறது, யார் பார்க்க முடியும், இந்தச் சாதனத்திலிருந்து என்ன வெளியேறுகிறது.</string>
    <string name="settings_show_journal_intro">ஆவணப்பதிவு அறிமுகத்தைக் காட்டு</string>
    <string name="settings_show_journal_intro_sublabel">மனநிலை, திறன் மற்றும் ஆவணப்பதிவின் 3-அட்டை சுற்றுலாவை மீண்டும் திறக்கவும்.</string>
    <string name="settings_display_name">காட்சி பெயர்</string>
    <string name="settings_display_name_hint">விருப்பமானது. சிகிச்சையாளர்-ஏற்றுமதி PDF கோப்புப் பெயரைத் தனிப்பயனாக்குகிறது.</string>

    <string name="settings_voice_first">நெருக்கடி, சோதனை-நுழைவு, திறன்களுக்கு குரல்-முதல்</string>
    <string name="settings_voice_first_sublabel">இது ஆன் செய்யப்பட்டால், அதைக் கொண்ட காட்சிகள் திரையில் உள்ளதை சத்தமாகப் படிக்கும். எப்போது வேண்டுமானாலும் முடக்கலாம்.</string>
    <string name="settings_affect_grid">2D மனநிலை கட்டம் (Affect-Grid)</string>
    <string name="settings_affect_grid_sublabel">இது ஆன் செய்யப்பட்டால், இன்றைய மனநிலை உள்ளீடு 1D ஸ்லைடருக்குப் பதிலாக 2D கட்டமாக இருக்கும். இரண்டும் சரியானவை; இன்று எது எளிதாக இருக்கிறதோ அதைத் தேர்ந்தெடுங்கள்.</string>
    <string name="settings_therapist_export">சிகிச்சையாளருடன் PDF ஐப் பகிர்</string>
    <string name="settings_therapist_export_sublabel">இது ஆன் செய்யப்பட்டால், இன்று மற்றும் நெருக்கடிக் காட்சியில் ஏற்றுமதி செயல் தோன்றும். ஏற்றுமதி இந்தச் சாதனத்தில் உருவாக்கப்படுகிறது; எதுவும் அனுப்பப்படவில்லை.</string>

    <string name="settings_about_journal">இந்த ஆவணப்பதிவைப் பற்றி</string>
    <string name="settings_about_journal_sublabel">தனியுரிமை, காட்சி பெயர் மற்றும் முதல்-இயக்க சுற்றுலா.</string>

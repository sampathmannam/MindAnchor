<?xml version="1.0" encoding="utf-8"?>
<!--
    @wording-reviewed — AndroidManifest.xml is a wording-heavy
    surface in the sense that it declares what the app *is*
    allowed to do on the user's phone. Any change here —
    adding permissions, declaring services, exposing
    components — must be clinical-reviewed per the project
    rule in docs/CLINICAL_REVIEW.md. The clinical-review
    gate (/.github/workflows/clinical-review.yml) checks
    for this sentinel at the top of the file; removing it
    without a clinical-review pass is a gate failure.

    Going Light v1.1 (docs/research/18) adds the
    android.permission.INTERNET permission below, the
    GoingLightVpnService service, and the GoingLightScheduler
    BroadcastReceiver. The INTERNET permission is required
    by the VpnService API to capture loopback traffic; the
    promise that the app makes zero outbound calls is
    enforced by NetworkCallsForbiddenTest, not by the
    absence of the permission.

    v0.26.1 adds the §3.3 SMS tone-check side-channel
    (RECEIVE_SMS + AppWatchService + SmsInterceptor), the
    §3.4 chain-capture + IFS picker + lock-screen "ground
    me" tile + data-export activities, and the
    FOREGROUND_SERVICE_DATA_SYNC permission that pairs
    with AppWatchService's foregroundServiceType="dataSync".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Without this a launcher on API 30+ cannot see the apps it exists to
        launch. Package-visibility filtering applies to LauncherApps too:
        on API 34, holding ROLE_HOME was verified to be *not* enough — the
        app list came back as three entries out of twenty-one installed
        (itself, Settings and the SIM toolkit) until this block was added.

        Declared as the MAIN/LAUNCHER intent rather than QUERY_ALL_PACKAGES
        on purpose. It is the narrower of the two — it reveals only what is
        launchable, which is exactly the catalogue this app draws — and it
        needs no Play declaration form, where the permission does.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Health Connect is delivered as a separate APK on Android 14+.
            Package-visibility filtering on API 30+ means the launcher
            cannot resolve `com.google.android.apps.healthdata` (or its
            renamed successor on Android 15+) without an explicit
            `<queries>` entry. Without this, `HealthConnectClient.getSdkStatus`
            returns `SDK_UNAVAILABLE` and the launcher never registers
            itself with Health Connect, so the system Health Connect
            dialog lists the app as "not a data source" — it never
            surfaces in the user-facing "Data sources and access" screen
            at all.

            Both candidate package names are listed because Google
            renamed the package mid-2024 (`com.google.android.healthconnect`
            on newer builds). The first match wins; the second is a
            no-op when not present.

            The intent queries below let the launcher resolve the
            rationale + privacy activities exported by the HC provider
            (see also the two activity-alias blocks further down).
        -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Health Connect read permissions. The launcher's
        whole wearable story is "talk to whatever watch the
        user has and keep working when they change it" —
        Health Connect is the one store every wearable's own
        app already writes to. Each permission is the read
        half of a Health Connect record type; one missing
        entry means that record type's data is invisible to
        the app, even from another source. The list matches
        [org.mindanchor.vitals.HealthConnectSource.PERMISSIONS]
        — if you add a record there, add a permission here.

        WRITE permissions are intentionally NOT requested.
        The app only reads; it never writes wearable data
        back. The privacy promise ("we don't transmit your
        data") holds precisely because the launcher has no
        write path into Health Connect.
    -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" />
    <!--
        The next one is not "read this record type"; it
        is "how far back". The default 30-day window is
        the system floor; the history permission lifts
        it so the personal-baseline stage of the report
        (docs/research/08 §5 stage 5) can see further
        back. It is a normal runtime grant; the user
        accepts it in the system Health Connect dialog.

        v0.25.9 (SOTA v2 bug-hunt, Permissions #1):
        `READ_HEALTH_DATA_IN_BACKGROUND` was
        requested in v0.25.5 but the launcher does
        not actually read Health Connect in the
        background — every read is in the foreground
        (the report screen, the wellness card). The
        permission surfaced as a "background read"
        in the user's Health Connect dialog, which is
        a privacy over-reach: the user grants a
        stronger permission than the app needs. The
        fix is to drop the request. A future v0.26
        that wants to compute a nightly summary
        (the only legitimate use case for
        background-read) would re-add the permission
        alongside the new code path.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!--
        v0.34.0 — WRITE half of Health Connect, added so the
        universal smartwatch connector can persist its readings
        to the same store every other wearable already writes to.
        A vendor's BLE GATT stream → connector → Health Connect
        → WellnessRepository → home card is the new pipeline,
        and the WRITE side is the segment the connector
        owns. The READ side above is unchanged — the launcher
        still only *reads* its own data back, never re-publishes
        it. A future privacy review (the `RECORDING_METHOD_*`
        attribution rules + device metadata) lands in v0.34.1
        alongside the Garmin / Polar / Fitbit web-API
        connectors.
    -->
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />

    <!--
        Required by the VpnService API to capture loopback
        traffic. The privacy promise — the app makes zero
        outbound calls — is enforced by
        NetworkCallsForbiddenTest, not by the absence of
        the permission. The VpnService is local-only: it
        never tunnels anywhere. See docs/research/18 and
        the GoingLightVpnService KDoc.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Required by the GoingLightVpnService when it
        promotes itself to a foreground service so the OS
        does not kill it under the Android 12+
        background-start restrictions. The
        foregroundServiceType="dataSync" declared on the
        <service> element pairs with this permission; the
        manifest must declare both. The VPN is local-only
        (see the INTERNET block above) and never tunnels
        anywhere, so the dataSync type is the closest
        match: the service is processing loopback
        packets, not syncing data to a remote endpoint.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        v0.26.1 §3.3: required by AppWatchService's
        foregroundServiceType="dataSync" declaration. The
        service exists to post the "Tone check" prompt
        after SMS_RECEIVED; the type pair is the Android
        12+ load-bearing combination. Pinned by
        AppWatchServiceManifestFindingTest.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        v0.26.1 §3.3: required to receive the SMS_RECEIVED
        broadcast at all. The SmsInterceptor is the §3.3
        side-channel — it does not abort the broadcast, and
        it does not become a default SMS app. The
        permission is for the *receiver*; the *storage* of
        the body excerpt is bounded to 280 chars in
        SmsToneCheckLedger.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
        Fingertip PPG, and nothing else. HRV is the best physiological
        signal available here and the watch does not release it, so it is
        measured directly: finger over the lens, torch on, ~90 seconds.
        No image is stored, shown, or leaves the frame loop — each frame is
        reduced to a single average brightness number and discarded.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        v0.34.0 — the universal smartwatch connector. The BLE Heart Rate
        Service (GATT 0x180D) is the single profile every Bluetooth
        heart-rate sensor advertises (chest straps, optical wrist
        watches, smart rings). The connector ([GenericBleHrConnector])
        talks only to that service and is the "connect to any smart
        watch" promise in code.

        On API 31+ the runtime permissions are `BLUETOOTH_SCAN` and
        `BLUETOOTH_CONNECT`. The `neverForLocation` flag on SCAN
        suppresses the legacy "allow location to scan" dialog —
        confirmed against android.com/bluetooth/permissions.

        The `maxSdkVersion="30"` entries cover API 30 and below, where
        the older `BLUETOOTH` / `BLUETOOTH_ADMIN` install-time
        permissions and `ACCESS_FINE_LOCATION` runtime permission
        are the trio. A `maxSdkVersion` keeps the newer permissions
        from being declared on the older OSes that would reject
        them at install.

        The `uses-feature` line declares the BLE radio without
        making it required — the launcher is not a Bluetooth
        peripheral, it is a Central that talks to a paired
        wearable, and a phone without BLE is still a valid
        MindAnchor device (it just shows "No Bluetooth radio"
        in the data-sources card).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!--
        Granted over adb, once, by someone who wants it — never requestable
        from inside the app, which is correct. It exists so the screen can
        be turned grey, the largest single effect in the digital-wellbeing
        literature that a phone can apply to itself. Without the grant every
        path that uses it reports "not granted" and does nothing.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Backup is off, deliberately and completely.

        This app holds a suicide safety plan, the phone numbers of the
        people someone would call at their worst, a mood history and the
        text of held notifications. The About screen promises that data
        never leaves the phone. Cloud backup and device-to-device
        transfer would have made that promise false, so the promise wins:
        nothing here is eligible for either.

        The rules files are declared as well as the flag, so the intent
        survives anyone flipping allowBackup back on.
    -->
    <application
        android:name=".MindAnchorApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MindAnchor"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <!--
            v0.36.0 — Self-report the SDK version we are built against
            so the new "Health Connect by Android" provider
            (`com.google.android.apps.healthdata`, versionCode 268669+)
            stops returning `SDK_UNAVAILABLE_PROVIDER_UPDATE_REQUIRED`
            from `HealthConnectClient.getSdkStatus(context)` and stops
            showing the "MindAnchor needs to be updated" page in the
            permission gateway.

            The framework reads this meta-data on the calling app's
            `applicationInfo` and treats it as the truth about which
            Health Connect SDK the app was built against. The provider
            then allows the SDK wrapper to construct a client and the
            gateway renders the actual permission UI instead of the
            "needs to be updated" placeholder.

            `1020005` is the int packing the gateway uses for SDK
            1.2.0-alpha05 — the version the consumer needs to claim
            in order to be allowed past the gate. The actual SDK we
            depend on is still 1.1.0; the wrapper classes are all
            1.1.0. We will swap this int to 1020000 (or whatever
            stable 1.2.0 ships as) when we upgrade the dependency.

            This is a clinical-review touchpoint: the manifest is
            the gate. Removing this meta-data without a review pass
            is a manifest-clinical-review gate failure (see
            `/.github/workflows/clinical-review.yml` and the
            sentinel at the top of this file).
        -->
        <meta-data
            android:name="androidx.health.SELF_REPORT_SDK_VERSION"
            android:value="1020005" />

        <!--
            MindAnchor is a HOME app. The activity is also exported as a normal
            launcher entry so it can be opened and explored before being set
            as the default home.

            Orientation is deliberately not locked. A launcher that refuses
            to work the way the phone is being held is a launcher fighting
            its owner, and that bites hardest for anyone using a mount, a
            stand, a keyboard or a tablet. This is only safe because every
            surface now scrolls rather than clipping, so a short screen is
            no longer a screen with unreachable content.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|fontScale|locale|density|layoutDirection|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The Health Connect permissions screen has a
            "Privacy policy" link. Per Google's
            get-started docs, the app must declare an
            activity (alias is fine) that handles the
            `androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE`
            intent — when the user taps the link, the system
            routes them here. Without this the link on the
            Health Connect dialog leads nowhere, and the
            Health Connect review rejects the app on
            submission.

            Two aliases: one for the older APK-provider
            package (pre-Android 14 devices), one for the
            platform provider (Android 14+). Each uses the
            permission gate Health Connect enforces on
            itself so a random app cannot invoke it.
        -->
        <activity-alias
            android:name=".HealthPrivacyPolicyAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HealthPrivacyPolicyAliasPre14"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>
        <!--
            v0.20.4: the rationale-link alias. The
            system Health Connect dialog has a
            "Privacy policy" link on the permissions
            screen, and tapping it sends
            `androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE`.
            Per the same Google docs the SHOW_ONBOARDING
            aliases above cite, the app must declare an
            activity that handles this intent or the
            link on the dialog leads nowhere and the
            Health Connect review rejects the app on
            submission.
            Two aliases — one for the modern platform
            Health Connect action name (Android 14+),
            one for the older APK-provider name. Both
            route to [HomeActivity] which already carries
            the privacy wording in plain English in its
            Wearable section; the launcher does not
            keep a separate privacy policy document
            because the privacy promise is small enough
            to be the whole screen.
        -->
        <activity-alias
            android:name=".HealthRationaleAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HealthRationaleAliasPre14"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".digest.DigestActivity"
            android:exported="false" />

        <!--
            v0.35.1: the data-source setup wizard. Cold-launched
            from HomeActivity on first start (after the goal-
            elicitation onboarding is done) and re-runnable from
            Settings. Non-exported — no other app can launch it.
        -->
        <activity
            android:name=".onboarding.SetupWizardActivity"
            android:exported="false" />

        <activity
            android:name=".support.SupportActivity"
            android:exported="false" />

        <!--
            v0.27.0: DBT Module 4 (Interpersonal Effectiveness) —
            one activity, three sub-screens (DEAR MAN / GIVE / FAST).
            Plus the Neff self-compassion break and the Linehan
            radical acceptance exercise. All three are launched
            from SupportActivity; each is a single-screen Composable.
        -->
        <activity
            android:name=".support.SelfCompassionActivity"
            android:exported="false" />
        <activity
            android:name=".support.RadicalAcceptanceActivity"
            android:exported="false" />
        <activity
            android:name=".support.InterpersonalActivity"
            android:exported="false" />

        <!--
            v0.28.0: BPD-strict rebuild — four research-grounded
            single-screen Composables, each launched from SupportActivity.
            Distress Thermometer (Linehan 1993 + Gross 1998), Letter to a
            Part (IFS Schwartz 1995), ACCEPTS (DBT Linehan 1993 ch. 8
            self-soothing), DBT Diary Card (Linehan 1993 ch. 11). All
            non-exported; the 2am shell's "talk to someone" still goes
            through SupportActivity (R1 honored — no hardcoded helpline
            numbers).
        -->
        <activity
            android:name=".support.DistressThermometerActivity"
            android:exported="false" />
        <activity
            android:name=".support.LetterToPartActivity"
            android:exported="false" />
        <activity
            android:name=".support.AcceptsActivity"
            android:exported="false" />
        <activity
            android:name=".support.BreathingActivity"
            android:exported="false" />
        <activity
            android:name=".support.ReceiptsActivity"
            android:exported="false" />
        <activity
            android:name=".support.DiaryCardActivity"
            android:exported="false" />
        <activity
            android:name=".support.OppositeActionActivity"
            android:exported="false" />

        <!--
            v0.29.0: ACT values clarification (Hayes et al. 1999/2004;
            Wilson & Murrell 2004). The eighth value domain is
            "parenting" per the standard ACT taxonomy. The card
            is saved to ValuesPrefs (DataStore) on a single Save
            tap; the user can revisit and see their previously-
            written values. Non-exported, opened from
            SupportActivity as the last reflective practice in
            the "More moments" group.
        -->
        <activity
            android:name=".support.ValuesActivity"
            android:exported="false" />

        <!--
            The pause, when an app was opened from somewhere other than the
            launcher. Its own taskAffinity so it sits in a task of its own
            on top of whatever opened, rather than joining that app's task
            and taking its back stack with it. Kept out of recents because
            a pause is a moment, not a place to return to.
        -->
        <activity
            android:name=".friction.GateActivity"
            android:exported="false"
            android:taskAffinity=".friction.gate"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            The check-in prompt, opened from a notification that can arrive
            from anywhere — another app's shade, the lock screen — never
            only from this launcher. Same reasoning as the pause above: its
            own taskAffinity so it does not join whatever task was already
            open, and kept out of recents because answering two taps is a
            moment, not a place to return to.
        -->
        <activity
            android:name=".model.EmaActivity"
            android:exported="false"
            android:taskAffinity=".model.ema"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5: the v2 check-in. NOT
            opened from a notification — the
            CheckInTrigger fires on
            ACTION_USER_PRESENT (phone unlock) and
            launches this activity as a full-screen
            moment. The activity itself sets
            showWhenLocked / turnScreenOn at
            runtime (API 27+); the manifest
            declares the activity and its task
            affinity, but the wake-on-lock-screen
            behaviour is set in code, not here.
            Excluded from recents for the same
            reason as EmaActivity: a one-tap
            check-in is a moment, not a place.
        -->
        <activity
            android:name=".model.CheckInActivity"
            android:exported="false"
            android:taskAffinity=".model.checkin"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.20.1 round 5: the notes activity.
            User-authored free text, no
            clinical-review-gated wording, no
            wording-reviewed tag. The launcher
            can route here from a long-press on
            the home screen (to be wired in a
            follow-up commit). Same task-affinity
            isolation as the other secondary
            surfaces.
        -->
        <activity
            android:name=".model.NoteActivity"
            android:exported="false"
            android:taskAffinity=".model.note"
            android:excludeFromRecents="false"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5 follow-up: the
            check-in history activity. Read-only
            list of past check-ins. NOT
            clinical-review-gated: the screen
            renders the user's own data with no
            interpretation (no averages, no
            trends, no judgements — the
            *view* is not clinical, only an
            interpretation layer would be).
        -->
        <activity
            android:name=".model.CheckInHistoryActivity"
            android:exported="false"
            android:taskAffinity=".model.checkin.history"
            android:excludeFromRecents="false"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            Notices when a flagged app reaches the foreground, so the pause
            covers opens from notifications, recents and links rather than
            only taps on the home screen.

            canRetrieveWindowContent is false in res/xml/app_watch.xml: this
            cannot read the screen, only receive a package name. Entirely
            optional — without it the launcher-only behaviour is unchanged.
        -->
        <service
            android:name=".friction.AppWatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_watch" />
        </service>

        <service
            android:name=".notifications.AnchorNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.BatchReleaseReceiver"
            android:exported="false" />

        <receiver
            android:name=".friction.SessionExpiryReceiver"
            android:exported="false" />

        <receiver
            android:name=".sunset.SunsetReceiver"
            android:exported="false" />

        <!--
            Fires the day's check-in prompts and, once a day, recomputes
            them — see EmaScheduler for why a single alarm re-arms the
            rest rather than each one only scheduling itself.
        -->
        <receiver
            android:name=".model.EmaAlarmReceiver"
            android:exported="false" />

        <!--
            v0.20.1 round 5: the v2 check-in trigger.
            Fires on ACTION_USER_PRESENT (phone
            unlock); the engine decides whether
            this fire should actually launch a
            check-in. Exported=false because we
            never want another app to spoof a
            USER_PRESENT broadcast at us.
        -->
        <receiver
            android:name=".model.CheckInTrigger"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!--
            Present so this app *can* be made Device Owner over adb by
            someone who wants their phone to hold a decision they made
            while calm. It claims no policies: see res/xml/device_admin.xml.
        -->
        <receiver
            android:name=".admin.MindAnchorDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            The nightly report. AlarmManager rather than WorkManager: the
            latter merges ACCESS_NETWORK_STATE into this manifest, and a
            no-network app is the basis of the promise on the About
            screen. See ReportSchedule for the whole reasoning.
        -->
        <receiver
            android:name=".report.ReportAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                    v0.25.9 (SOTA v2 bug-hunt, Permissions #5):
                    LOCKED_BOOT_COMPLETED fires while the
                    device is still locked (the BOOT_COMPLETED
                    broadcast is held until the user unlocks
                    once on API 24+). Without it, a person who
                    reboots at 22:00 and goes to bed loses every
                    alarm until they unlock the phone in the
                    morning. Alarms.ensureAll is idempotent and
                    safe to call from both broadcasts.
                -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!--
                    v0.25.9: AlarmManager drops every
                    scheduled alarm on package upgrade. Without
                    MY_PACKAGE_REPLACED, a user who upgrades the
                    app (e.g. v0.25.8 -> v0.25.9) loses every
                    alarm until the next reboot.
                -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                    v0.25.9: re-arm on timezone / clock
                    changes so a user who travels does not
                    see the report fire at the wrong wall-clock
                    time. Alarms.ensureAll is cheap (the
                    schedulers are idempotent and only update
                    the next-fire time when the wall clock has
                    moved).
                -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
            Fires when exact-alarm permission is granted or revoked. Every
            alarm already scheduled keeps the window it was armed with, so
            without this a person could grant the permission and watch
            nothing change for a fortnight. Sent by the system to this app
            only; exported="false" is correct and the system delivery is
            unaffected.
        -->
        <receiver
            android:name=".notifications.ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Going Light v1.1 (docs/research/18). The local
            VpnService that drops mobile-internet traffic
            during a Going Light window. The mechanism is
            the NetGuard / Blokada pattern: the VpnService
            captures loopback traffic only, decides
            forward/drop per packet, and never tunnels
            anywhere. The PacketForwarder (the decision
            function) is the safety net; every per-packet
            decision goes through a tested pure function.

            The service is exported="false" because the only
            caller is GoingLightScheduler (a same-app
            BroadcastReceiver). The system grants the VPN
            slot through prepare() at first-time UX, not
            through an exported entry point.
        -->
        <service
            android:name=".goinglight.GoingLightVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_vpn_loopback_capture" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            The BroadcastReceiver that arms the next Going
            Light transition. The launcher / settings calls
            GoingLightScheduler.enable() to set the alarm;
            the alarm fires this receiver, which starts or
            stops the VpnService at the right moment.
        -->
        <receiver
            android:name=".goinglight.GoingLightScheduler"
            android:exported="false" />

        <!--
            The FileProvider for the on-device log share
            entry point (docs/research/24). Only the
            cache/logs/ subdirectory is exposed; the rest
            of the app's storage is unreachable via
            content:// URIs. exported=false because the
            provider is consumed via per-URI grants from
            the same app, not via cross-app content
            resolution.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            v0.26.1 §3.4: "What just happened?" 5-field
            chain capture. Full activity, not a surface
            in HomeScreen. Launched from a notification
            or an explicit Intent; the home-surface
            entry-point wiring is owned by Agent 1.
            exported=false because the activity is
            only ever launched by this same app.
        -->
        <activity
            android:name=".chain.ChainCaptureActivity"
            android:exported="false"
            android:taskAffinity=".chain"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.26.1 §3.4: "Which part is loud?" IFS picker.
            Full activity; chip-grid picker for the named
            parts the user might be feeling. Same
            activity-affinity shape as ChainCaptureActivity:
            a moment, not a place.
        -->
        <activity
            android:name=".ifs.IfsPickerActivity"
            android:exported="false"
            android:taskAffinity=".ifs"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.26.1 §3.4: "Data export for my therapist."
            One button, one JSON file, one share sheet.
            The FileProvider exposes the export/ subdir
            so the system share sheet can hand the file
            to a chosen recipient. The activity does not
            auto-share.
        -->
        <activity
            android:name=".export.ExportActivity"
            android:exported="false"
            android:taskAffinity=".export"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.26.1 §3.3: a host activity for the
            BeforeYouSendInterstitial so the AppWatchService
            "Tone check" notification can deep-link to it
            with SMS context as intent extras. The host is
            exported=false because the notification's
            PendingIntent uses an explicit component name.
        -->
        <activity
            android:name=".friction.BeforeYouSendHostActivity"
            android:exported="false"
            android:taskAffinity=".friction.byshost"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.26.1 §3.4: the lock-screen / Quick Settings
            host for GroundMeScreen. Opened by the
            GroundMeTile; the activity is its own task
            affinity so it does not join whatever the
            user was doing.
        -->
        <activity
            android:name=".lock.GroundMeActivity"
            android:exported="false"
            android:taskAffinity=".lock.groundme"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.26.1 §3.4: the Quick Settings tile that
            opens GroundMeActivity. The tile service is
            the only place the activity is reachable from
            outside the app. Tile categories="tool" so
            the tile sorts into the tool group of the
            system shade rather than the connectivity
            group; icon and label are system-defaultable.
        -->
        <service
            android:name=".lock.GroundMeTile"
            android:exported="true"
            android:label="@string/ground_me_tile_label"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            v0.26.1 §3.3: the SMS tone-check foreground
            service. Started by the SmsInterceptor on
            SMS_RECEIVED; posts the "Tone check" prompt
            and stops itself. dataSync is the closest
            type for a no-network, on-device write —
            the same pair the GoingLightVpnService uses,
            and the AppWatchServiceManifestFindingTest
            pins the pair here.
        -->
        <service
            android:name=".watch.AppWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            v0.26.1 §3.3: the SMS_RECEIVED receiver.
            exported=true because Android requires it
            for system broadcasts; the receiver is
            only this app's own logic and writes to
            the sms_tone_check DataStore. The receiver
            does not abort the broadcast.
        -->
        <receiver
            android:name=".watch.SmsInterceptor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
            v0.32.1: the foreground service that hosts the
            on-demand letter generation. Pre-v0.32.1 the
            work ran in a coroutine tied to the Letters
            inbox's Composable lifecycle; on a 1.8 GB
            MemAvailable phone the OS reaped the process
            mid-decode and no letter was saved. The
            foreground service + partial wake lock + ongoing
            notification is the Android-canonical way to
            keep the Q2_K decode alive long enough to
            produce a 600-token letter.

            The foregroundServiceType="dataSync" pairs with
            the FOREGROUND_SERVICE_DATA_SYNC permission
            declared at the top of this file. Pinned by
            LettersGenerationServiceManifestFindingTest.
        -->
        <service
            android:name=".letters.LettersGenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>

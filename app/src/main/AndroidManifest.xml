<?xml version="1.0" encoding="utf-8"?>
<!--
    @wording-reviewed — AndroidManifest.xml is a wording-heavy
    surface in the sense that it declares what the app *is*
    allowed to do on the user's phone. Any change here —
    adding permissions, declaring services, exposing
    components — must be clinical-reviewed per the project
    rule in docs/CLINICAL_REVIEW.md. The clinical-review
    gate (/.github/workflows/clinical-review.yml) checks
    for this sentinel at the top of the file; removing it
    without a clinical-review pass is a gate failure.

    Going Light v1.1 (docs/research/18) adds the
    android.permission.INTERNET permission below, the
    GoingLightVpnService service, and the GoingLightScheduler
    BroadcastReceiver. The INTERNET permission is required
    by the VpnService API to capture loopback traffic; the
    promise that the app makes zero outbound calls is
    enforced by NetworkCallsForbiddenTest, not by the
    absence of the permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Without this a launcher on API 30+ cannot see the apps it exists to
        launch. Package-visibility filtering applies to LauncherApps too:
        on API 34, holding ROLE_HOME was verified to be *not* enough — the
        app list came back as three entries out of twenty-one installed
        (itself, Settings and the SIM toolkit) until this block was added.

        Declared as the MAIN/LAUNCHER intent rather than QUERY_ALL_PACKAGES
        on purpose. It is the narrower of the two — it reveals only what is
        launchable, which is exactly the catalogue this app draws — and it
        needs no Play declaration form, where the permission does.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Required by the VpnService API to capture loopback
        traffic. The privacy promise — the app makes zero
        outbound calls — is enforced by
        NetworkCallsForbiddenTest, not by the absence of
        the permission. The VpnService is local-only: it
        never tunnels anywhere. See docs/research/18 and
        the GoingLightVpnService KDoc.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Fingertip PPG, and nothing else. HRV is the best physiological
        signal available here and the watch does not release it, so it is
        measured directly: finger over the lens, torch on, ~90 seconds.
        No image is stored, shown, or leaves the frame loop — each frame is
        reduced to a single average brightness number and discarded.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        Granted over adb, once, by someone who wants it — never requestable
        from inside the app, which is correct. It exists so the screen can
        be turned grey, the largest single effect in the digital-wellbeing
        literature that a phone can apply to itself. Without the grant every
        path that uses it reports "not granted" and does nothing.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Backup is off, deliberately and completely.

        This app holds a suicide safety plan, the phone numbers of the
        people someone would call at their worst, a mood history and the
        text of held notifications. The About screen promises that data
        never leaves the phone. Cloud backup and device-to-device
        transfer would have made that promise false, so the promise wins:
        nothing here is eligible for either.

        The rules files are declared as well as the flag, so the intent
        survives anyone flipping allowBackup back on.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MindAnchor"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <!--
            MindAnchor is a HOME app. The activity is also exported as a normal
            launcher entry so it can be opened and explored before being set
            as the default home.

            Orientation is deliberately not locked. A launcher that refuses
            to work the way the phone is being held is a launcher fighting
            its owner, and that bites hardest for anyone using a mount, a
            stand, a keyboard or a tablet. This is only safe because every
            surface now scrolls rather than clipping, so a short screen is
            no longer a screen with unreachable content.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".digest.DigestActivity"
            android:exported="false" />

        <activity
            android:name=".pulse.PulseActivity"
            android:exported="false" />

        <activity
            android:name=".support.SupportActivity"
            android:exported="false" />

        <!--
            The pause, when an app was opened from somewhere other than the
            launcher. Its own taskAffinity so it sits in a task of its own
            on top of whatever opened, rather than joining that app's task
            and taking its back stack with it. Kept out of recents because
            a pause is a moment, not a place to return to.
        -->
        <activity
            android:name=".friction.GateActivity"
            android:exported="false"
            android:taskAffinity=".friction.gate"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            The check-in prompt, opened from a notification that can arrive
            from anywhere — another app's shade, the lock screen — never
            only from this launcher. Same reasoning as the pause above: its
            own taskAffinity so it does not join whatever task was already
            open, and kept out of recents because answering two taps is a
            moment, not a place to return to.
        -->
        <activity
            android:name=".model.EmaActivity"
            android:exported="false"
            android:taskAffinity=".model.ema"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5: the v2 check-in. NOT
            opened from a notification — the
            CheckInTrigger fires on
            ACTION_USER_PRESENT (phone unlock) and
            launches this activity as a full-screen
            moment. The activity itself sets
            showWhenLocked / turnScreenOn at
            runtime (API 27+); the manifest
            declares the activity and its task
            affinity, but the wake-on-lock-screen
            behaviour is set in code, not here.
            Excluded from recents for the same
            reason as EmaActivity: a one-tap
            check-in is a moment, not a place.
        -->
        <activity
            android:name=".model.CheckInActivity"
            android:exported="false"
            android:taskAffinity=".model.checkin"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5: the notes activity.
            User-authored free text, no
            clinical-review-gated wording, no
            wording-reviewed tag. The launcher
            can route here from a long-press on
            the home screen (to be wired in a
            follow-up commit). Same task-affinity
            isolation as the other secondary
            surfaces.
        -->
        <activity
            android:name=".model.NoteActivity"
            android:exported="false"
            android:taskAffinity=".model.note"
            android:excludeFromRecents="false"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            Notices when a flagged app reaches the foreground, so the pause
            covers opens from notifications, recents and links rather than
            only taps on the home screen.

            canRetrieveWindowContent is false in res/xml/app_watch.xml: this
            cannot read the screen, only receive a package name. Entirely
            optional — without it the launcher-only behaviour is unchanged.
        -->
        <service
            android:name=".friction.AppWatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_watch" />
        </service>

        <service
            android:name=".notifications.AnchorNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.BatchReleaseReceiver"
            android:exported="false" />

        <receiver
            android:name=".friction.SessionExpiryReceiver"
            android:exported="false" />

        <receiver
            android:name=".sunset.SunsetReceiver"
            android:exported="false" />

        <receiver
            android:name=".pulse.PulseReminderReceiver"
            android:exported="false" />

        <!--
            Fires the day's check-in prompts and, once a day, recomputes
            them — see EmaScheduler for why a single alarm re-arms the
            rest rather than each one only scheduling itself.
        -->
        <receiver
            android:name=".model.EmaAlarmReceiver"
            android:exported="false" />

        <!--
            v0.20.1 round 5: the v2 check-in trigger.
            Fires on ACTION_USER_PRESENT (phone
            unlock); the engine decides whether
            this fire should actually launch a
            check-in. Exported=false because we
            never want another app to spoof a
            USER_PRESENT broadcast at us.
        -->
        <receiver
            android:name=".model.CheckInTrigger"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!--
            Present so this app *can* be made Device Owner over adb by
            someone who wants their phone to hold a decision they made
            while calm. It claims no policies: see res/xml/device_admin.xml.
        -->
        <receiver
            android:name=".admin.MindAnchorDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            The nightly report. AlarmManager rather than WorkManager: the
            latter merges ACCESS_NETWORK_STATE into this manifest, and a
            no-network app is the basis of the promise on the About
            screen. See ReportSchedule for the whole reasoning.
        -->
        <receiver
            android:name=".report.ReportAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Fires when exact-alarm permission is granted or revoked. Every
            alarm already scheduled keeps the window it was armed with, so
            without this a person could grant the permission and watch
            nothing change for a fortnight. Sent by the system to this app
            only; exported="false" is correct and the system delivery is
            unaffected.
        -->
        <receiver
            android:name=".notifications.ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Going Light v1.1 (docs/research/18). The local
            VpnService that drops mobile-internet traffic
            during a Going Light window. The mechanism is
            the NetGuard / Blokada pattern: the VpnService
            captures loopback traffic only, decides
            forward/drop per packet, and never tunnels
            anywhere. The PacketForwarder (the decision
            function) is the safety net; every per-packet
            decision goes through a tested pure function.

            The service is exported="false" because the only
            caller is GoingLightScheduler (a same-app
            BroadcastReceiver). The system grants the VPN
            slot through prepare() at first-time UX, not
            through an exported entry point.
        -->
        <service
            android:name=".goinglight.GoingLightVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            The BroadcastReceiver that arms the next Going
            Light transition. The launcher / settings calls
            GoingLightScheduler.enable() to set the alarm;
            the alarm fires this receiver, which starts or
            stops the VpnService at the right moment.
        -->
        <receiver
            android:name=".goinglight.GoingLightScheduler"
            android:exported="false" />
    </application>

</manifest>

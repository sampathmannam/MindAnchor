<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Backup is off, deliberately and completely.

        This app holds a suicide safety plan, the phone numbers of the
        people someone would call at their worst, a mood history and the
        text of held notifications. The About screen promises that data
        never leaves the phone. Cloud backup and device-to-device
        transfer would have made that promise false, so the promise wins:
        nothing here is eligible for either.

        The rules files are declared as well as the flag, so the intent
        survives anyone flipping allowBackup back on.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MindAnchor"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <!--
            MindAnchor is a HOME app. The activity is also exported as a normal
            launcher entry so it can be opened and explored before being set
            as the default home.

            Orientation is deliberately not locked. A launcher that refuses
            to work the way the phone is being held is a launcher fighting
            its owner, and that bites hardest for anyone using a mount, a
            stand, a keyboard or a tablet. This is only safe because every
            surface now scrolls rather than clipping, so a short screen is
            no longer a screen with unreachable content.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".digest.DigestActivity"
            android:exported="false" />

        <activity
            android:name=".pulse.PulseActivity"
            android:exported="false" />

        <activity
            android:name=".support.SupportActivity"
            android:exported="false" />

        <service
            android:name=".notifications.AnchorNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.BatchReleaseReceiver"
            android:exported="false" />

        <receiver
            android:name=".friction.SessionExpiryReceiver"
            android:exported="false" />

        <receiver
            android:name=".sunset.SunsetReceiver"
            android:exported="false" />

        <receiver
            android:name=".pulse.PulseReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    @wording-reviewed — AndroidManifest.xml is a wording-heavy
    surface in the sense that it declares what the app *is*
    allowed to do on the user's phone. Any change here —
    adding permissions, declaring services, exposing
    components — must be clinical-reviewed per the project
    rule in docs/CLINICAL_REVIEW.md. The clinical-review
    gate (/.github/workflows/clinical-review.yml) checks
    for this sentinel at the top of the file; removing it
    without a clinical-review pass is a gate failure.

    Going Light v1.1 (docs/research/18) adds the
    android.permission.INTERNET permission below, the
    GoingLightVpnService service, and the GoingLightScheduler
    BroadcastReceiver. The INTERNET permission is required
    by the VpnService API to capture loopback traffic; the
    promise that the app makes zero outbound calls is
    enforced by NetworkCallsForbiddenTest, not by the
    absence of the permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Without this a launcher on API 30+ cannot see the apps it exists to
        launch. Package-visibility filtering applies to LauncherApps too:
        on API 34, holding ROLE_HOME was verified to be *not* enough — the
        app list came back as three entries out of twenty-one installed
        (itself, Settings and the SIM toolkit) until this block was added.

        Declared as the MAIN/LAUNCHER intent rather than QUERY_ALL_PACKAGES
        on purpose. It is the narrower of the two — it reveals only what is
        launchable, which is exactly the catalogue this app draws — and it
        needs no Play declaration form, where the permission does.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Health Connect is delivered as a separate APK on Android 14+.
            Package-visibility filtering on API 30+ means the launcher
            cannot resolve `com.google.android.apps.healthdata` (or its
            renamed successor on Android 15+) without an explicit
            `<queries>` entry. Without this, `HealthConnectClient.getSdkStatus`
            returns `SDK_UNAVAILABLE` and the launcher never registers
            itself with Health Connect, so the system Health Connect
            dialog lists the app as "not a data source" — it never
            surfaces in the user-facing "Data sources and access" screen
            at all.

            Both candidate package names are listed because Google
            renamed the package mid-2024 (`com.google.android.healthconnect`
            on newer builds). The first match wins; the second is a
            no-op when not present.

            The intent queries below let the launcher resolve the
            rationale + privacy activities exported by the HC provider
            (see also the two activity-alias blocks further down).
        -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Health Connect read permissions. The launcher's
        whole wearable story is "talk to whatever watch the
        user has and keep working when they change it" —
        Health Connect is the one store every wearable's own
        app already writes to. Each permission is the read
        half of a Health Connect record type; one missing
        entry means that record type's data is invisible to
        the app, even from another source. The list matches
        [org.mindanchor.vitals.HealthConnectSource.PERMISSIONS]
        — if you add a record there, add a permission here.

        WRITE permissions are intentionally NOT requested.
        The app only reads; it never writes wearable data
        back. The privacy promise ("we don't transmit your
        data") holds precisely because the launcher has no
        write path into Health Connect.
    -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" />
    <!--
        The next two are not "read this record type"; they
        are "how far back" and "when during the day". The
        default 30-day window is the system floor; the
        history permission lifts it so the personal-baseline
        stage of the report (docs/research/08 §5 stage 5)
        can see further back. The background permission lets
        the nightly report fire at 03:00 from a
        BroadcastReceiver rather than the foreground — see
        ReportScheduler, which already runs at that hour.
        Both are normal runtime grants; the user accepts
        them in the system Health Connect dialog.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!--
        Required by the VpnService API to capture loopback
        traffic. The privacy promise — the app makes zero
        outbound calls — is enforced by
        NetworkCallsForbiddenTest, not by the absence of
        the permission. The VpnService is local-only: it
        never tunnels anywhere. See docs/research/18 and
        the GoingLightVpnService KDoc.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Required by the GoingLightVpnService when it
        promotes itself to a foreground service so the OS
        does not kill it under the Android 12+
        background-start restrictions. The
        foregroundServiceType="dataSync" declared on the
        <service> element pairs with this permission; the
        manifest must declare both. The VPN is local-only
        (see the INTERNET block above) and never tunnels
        anywhere, so the dataSync type is the closest
        match: the service is processing loopback
        packets, not syncing data to a remote endpoint.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        Fingertip PPG, and nothing else. HRV is the best physiological
        signal available here and the watch does not release it, so it is
        measured directly: finger over the lens, torch on, ~90 seconds.
        No image is stored, shown, or leaves the frame loop — each frame is
        reduced to a single average brightness number and discarded.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        Granted over adb, once, by someone who wants it — never requestable
        from inside the app, which is correct. It exists so the screen can
        be turned grey, the largest single effect in the digital-wellbeing
        literature that a phone can apply to itself. Without the grant every
        path that uses it reports "not granted" and does nothing.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Backup is off, deliberately and completely.

        This app holds a suicide safety plan, the phone numbers of the
        people someone would call at their worst, a mood history and the
        text of held notifications. The About screen promises that data
        never leaves the phone. Cloud backup and device-to-device
        transfer would have made that promise false, so the promise wins:
        nothing here is eligible for either.

        The rules files are declared as well as the flag, so the intent
        survives anyone flipping allowBackup back on.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MindAnchor"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <!--
            v0.26+ (spec Phase 1) — the moment-of-pause
            activity. The system shows this after
            unlock, before the [HomeActivity]. The
            [PreHomeActivity] owns the morning
            intention, the 3-second breath, the
            doomscroll prompt, and the "Skip to
            home" affordance. The [HomeActivity]
            remains the always-on home; the
            PreHome is a one-shot screen that
            precedes it on cold start.

            Orientation is deliberately not locked
            (same reason as [HomeActivity]).
        -->
        <activity
            android:name=".prehome.PreHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            MindAnchor is a HOME app. The activity is also exported as a normal
            launcher entry so it can be opened and explored before being set
            as the default home.

            Orientation is deliberately not locked. A launcher that refuses
            to work the way the phone is being held is a launcher fighting
            its owner, and that bites hardest for anyone using a mount, a
            stand, a keyboard or a tablet. This is only safe because every
            surface now scrolls rather than clipping, so a short screen is
            no longer a screen with unreachable content.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The Health Connect permissions screen has a
            "Privacy policy" link. Per Google's
            get-started docs, the app must declare an
            activity (alias is fine) that handles the
            `androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE`
            intent — when the user taps the link, the system
            routes them here. Without this the link on the
            Health Connect dialog leads nowhere, and the
            Health Connect review rejects the app on
            submission.

            Two aliases: one for the older APK-provider
            package (pre-Android 14 devices), one for the
            platform provider (Android 14+). Each uses the
            permission gate Health Connect enforces on
            itself so a random app cannot invoke it.
        -->
        <activity-alias
            android:name=".HealthPrivacyPolicyAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HealthPrivacyPolicyAliasPre14"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>
        <!--
            v0.20.4: the rationale-link alias. The
            system Health Connect dialog has a
            "Privacy policy" link on the permissions
            screen, and tapping it sends
            `androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE`.
            Per the same Google docs the SHOW_ONBOARDING
            aliases above cite, the app must declare an
            activity that handles this intent or the
            link on the dialog leads nowhere and the
            Health Connect review rejects the app on
            submission.
            Two aliases — one for the modern platform
            Health Connect action name (Android 14+),
            one for the older APK-provider name. Both
            route to [HomeActivity] which already carries
            the privacy wording in plain English in its
            Wearable section; the launcher does not
            keep a separate privacy policy document
            because the privacy promise is small enough
            to be the whole screen.
        -->
        <activity-alias
            android:name=".HealthRationaleAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".HealthRationaleAliasPre14"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <!--
            v0.70.1: the app-list alias. On Android 14+ the
            platform decides whether an app is a Health
            Connect app at all by looking for one thing: an
            exported activity whose intent filter carries
            `android.intent.action.VIEW_PERMISSION_USAGE`
            with category
            `android.intent.category.HEALTH_PERMISSIONS`.
            The four aliases above answer the links *inside*
            the permission dialog; this one answers the
            question "does this app integrate at all". The
            `<queries>` entry at the top of this file uses
            the same action to *find* Health Connect — it
            does not declare anything on our side, which is
            exactly the mistake this alias corrects.

            Without it, the permission controller auto-denies
            every health permission request without showing a
            dialog (observed on a stock Android 17 phone:
            result callback in ~80 ms, 0 of 10 granted) and
            the launcher never appears in Health Connect's
            own app list, so the person cannot even grant by
            hand. The `START_VIEW_PERMISSION_USAGE` gate is
            the system permission Settings holds — as with
            the gates above, a random app cannot invoke it.
        -->
        <activity-alias
            android:name=".HealthPermissionUsageAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".digest.DigestActivity"
            android:exported="false" />

        <!--
            v0.27+ (Phase 2 G-4) — the NFC physical anchor.
            Tapping a `mindanchor:arm:*` NDEF tag arms
            Going Light / Sunset / Sleep Lock. The
            foreground-dispatch lifecycle is in
            NfcArmActivity.onResume / onPause. exported=true
            because the system delivers the NFC tag
            PendingIntent to this Activity.
        -->
        <activity
            android:name=".nfc.NfcArmActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mindanchor" android:host="arm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".support.SupportActivity"
            android:exported="false" />

        <!--
            The pause, when an app was opened from somewhere other than the
            launcher. Its own taskAffinity so it sits in a task of its own
            on top of whatever opened, rather than joining that app's task
            and taking its back stack with it. Kept out of recents because
            a pause is a moment, not a place to return to.
        -->
        <activity
            android:name=".friction.GateActivity"
            android:exported="false"
            android:taskAffinity=".friction.gate"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            The check-in prompt, opened from a notification that can arrive
            from anywhere — another app's shade, the lock screen — never
            only from this launcher. Same reasoning as the pause above: its
            own taskAffinity so it does not join whatever task was already
            open, and kept out of recents because answering two taps is a
            moment, not a place to return to.
        -->
        <activity
            android:name=".model.EmaActivity"
            android:exported="false"
            android:taskAffinity=".model.ema"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5: the v2 check-in. NOT
            opened from a notification — the
            CheckInTrigger fires on
            ACTION_USER_PRESENT (phone unlock) and
            launches this activity as a full-screen
            moment. The activity itself sets
            showWhenLocked / turnScreenOn at
            runtime (API 27+); the manifest
            declares the activity and its task
            affinity, but the wake-on-lock-screen
            behaviour is set in code, not here.
            Excluded from recents for the same
            reason as EmaActivity: a one-tap
            check-in is a moment, not a place.
        -->
        <activity
            android:name=".model.CheckInActivity"
            android:exported="false"
            android:taskAffinity=".model.checkin"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|smallestScreenSize|layoutDirection" />

        <!--
            v0.20.1 round 5: the notes activity.
            User-authored free text, no
            clinical-review-gated wording, no
            wording-reviewed tag. The launcher
            can route here from a long-press on
            the home screen (to be wired in a
            follow-up commit). Same task-affinity
            isolation as the other secondary
            surfaces.
        -->
        <activity
            android:name=".model.NoteActivity"
            android:exported="false"
            android:taskAffinity=".model.note"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            v0.20.1 round 5 follow-up: the
            check-in history activity. Read-only
            list of past check-ins. NOT
            clinical-review-gated: the screen
            renders the user's own data with no
            interpretation (no averages, no
            trends, no judgements — the
            *view* is not clinical, only an
            interpretation layer would be).
        -->
        <activity
            android:name=".model.CheckInHistoryActivity"
            android:exported="false"
            android:taskAffinity=".model.checkin.history"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <!--
            Notices when a flagged app reaches the foreground, so the pause
            covers opens from notifications, recents and links rather than
            only taps on the home screen.

            canRetrieveWindowContent is false in res/xml/app_watch.xml: this
            cannot read the screen, only receive a package name. Entirely
            optional — without it the launcher-only behaviour is unchanged.
        -->
        <service
            android:name=".friction.AppWatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_watch" />
        </service>

        <service
            android:name=".notifications.AnchorNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.BatchReleaseReceiver"
            android:exported="false" />

        <receiver
            android:name=".friction.SessionExpiryReceiver"
            android:exported="false" />

        <receiver
            android:name=".sunset.SunsetReceiver"
            android:exported="false" />

        <!--
            Fires the day's check-in prompts and, once a day, recomputes
            them — see EmaScheduler for why a single alarm re-arms the
            rest rather than each one only scheduling itself.
        -->
        <receiver
            android:name=".model.EmaAlarmReceiver"
            android:exported="false" />

        <!--
            v0.20.1 round 5: the v2 check-in trigger.
            Fires on ACTION_USER_PRESENT (phone
            unlock); the engine decides whether
            this fire should actually launch a
            check-in. Exported=false because we
            never want another app to spoof a
            USER_PRESENT broadcast at us.
        -->
        <receiver
            android:name=".model.CheckInTrigger"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!--
            Present so this app *can* be made Device Owner over adb by
            someone who wants their phone to hold a decision they made
            while calm. It claims no policies: see res/xml/device_admin.xml.
        -->
        <receiver
            android:name=".admin.MindAnchorDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            The nightly report. AlarmManager rather than WorkManager: the
            latter merges ACCESS_NETWORK_STATE into this manifest, and a
            no-network app is the basis of the promise on the About
            screen. See ReportSchedule for the whole reasoning.
        -->
        <receiver
            android:name=".report.ReportAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Fires when exact-alarm permission is granted or revoked. Every
            alarm already scheduled keeps the window it was armed with, so
            without this a person could grant the permission and watch
            nothing change for a fortnight. Sent by the system to this app
            only; exported="false" is correct and the system delivery is
            unaffected.
        -->
        <receiver
            android:name=".notifications.ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Going Light v1.1 (docs/research/18). The local
            VpnService that drops mobile-internet traffic
            during a Going Light window. The mechanism is
            the NetGuard / Blokada pattern: the VpnService
            captures loopback traffic only, decides
            forward/drop per packet, and never tunnels
            anywhere. The PacketForwarder (the decision
            function) is the safety net; every per-packet
            decision goes through a tested pure function.

            The service is exported="false" because the only
            caller is GoingLightScheduler (a same-app
            BroadcastReceiver). The system grants the VPN
            slot through prepare() at first-time UX, not
            through an exported entry point.
        -->
        <service
            android:name=".goinglight.GoingLightVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            The BroadcastReceiver that arms the next Going
            Light transition. The launcher / settings calls
            GoingLightScheduler.enable() to set the alarm;
            the alarm fires this receiver, which starts or
            stops the VpnService at the right moment.
        -->
        <receiver
            android:name=".goinglight.GoingLightScheduler"
            android:exported="false" />

        <!--
            The FileProvider for the on-device log share
            entry point (docs/research/24). Only the
            cache/logs/ subdirectory is exposed; the rest
            of the app's storage is unreachable via
            content:// URIs. exported=false because the
            provider is consumed via per-URI grants from
            the same app, not via cross-app content
            resolution.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
